# =====================================================
# AI News to Discord - 環境変数テンプレート
# =====================================================
# このファイルをコピーして .env を作成してください:
#   cp .env.example .env
# .env はコミットしないこと(.gitignoreで除外済み)。

# --- Discord Webhook URL (必須) ---
# DiscordチャンネルでWebhookを作成し、URLを取得して貼り付け。
# 取得手順: チャンネル設定 → 連携サービス → Webhook → 新しいWebhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxxxxxxxxx/xxxxxxxxxxxxxxxxxxxx

# --- Anthropic API Key (ローカル動作確認のみ必須) ---
# 本番(GitHub Actions)では Claude Code Action がリポジトリSecretから読みます。
# ローカルで main.py を直接実行して全フローを試すときだけ必要です。
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- 任意: 使用するClaudeモデル(デフォルト: claude-sonnet-4-5) ---
# ANTHROPIC_MODEL=claude-sonnet-4-5
